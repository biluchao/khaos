{
  "//1": "KHAOS Node 环境 TypeScript 配置 v3.0 - 华尔街机构级强化版",
  "//2": "用于 Vite/Vitest 等构建工具配置文件。启用 composite 以支持项目引用。",
  "compilerOptions": {
    /* ===== 项目引用与输出 ===== */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/tsconfig-node-declarations",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig-node.tsbuildinfo",
    "noEmitOnError": true,

    /* ===== 目标与环境 ===== */
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node", "vite/client"],

    /* ===== 严格类型检查 (显式声明所有子项) ===== */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    /* ===== 模块与解析 ===== */
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowJs": false,
    "skipLibCheck": false,
    "useDefineForClassFields": true,
    "removeComments": false,
    "sourceMap": false,

    /* ===== 路径与文件 ===== */
    "rootDir": ".",

    /* ===== 诊断与格式 ===== */
    "noErrorTruncation": true,
    "newLine": "lf",
    "charset": "utf8",
    "pretty": true,
    "locale": "zh-CN",
    "preserveWatchOutput": true,

    /* ===== 性能 ===== */
    "incremental": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
