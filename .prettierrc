{
  "$schema": "https://json.schemastore.org/prettierrc",
  // 适配 4K 宽屏，保持代码紧凑的同时兼顾可读性
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  // 金融系统要求所有语句必须以分号结束，消除歧义
  "semi": true,
  // 统一使用单引号，JSX 中同样使用单引号
  "singleQuote": true,
  "jsxSingleQuote": true,
  // 对象属性仅在必要时添加引号
  "quoteProps": "as-needed",
  // 尾随逗号最大化，与 ES2022 兼容，增强 git diff 清晰度
  "trailingComma": "all",
  // 对象花括号内保留空格
  "bracketSpacing": true,
  // JSX 多行元素的闭合括号另起一行，提升可读性
  "bracketSameLine": false,
  // 箭头函数参数始终使用括号
  "arrowParens": "always",
  // 不要求文件顶部包含格式化标记，所有文件均被格式化
  "requirePragma": false,
  // Markdown 自动换行，确保文档整洁
  "proseWrap": "always",
  // HTML 空白处理遵循 CSS 规则
  "htmlWhitespaceSensitivity": "css",
  // 统一换行符为 LF，避免跨平台问题（请配合 .gitattributes 使用）
  "endOfLine": "lf",
  // 允许格式化嵌入在模板字符串中的代码
  "embeddedLanguageFormatting": "auto",
  // 强制 JSX 中每个属性独占一行，显著提高复杂组件的可读性
  "singleAttributePerLine": true,
  // 忽略文件列表，遵循 .prettierignore
  "ignorePath": ".prettierignore",
  // 注意：不配置 plugins，导入排序完全由 ESLint 规则管理，避免自动化风险
  "overrides": [
    // JSON 文件必须使用双引号，且不允许尾随逗号
    {
      "files": "*.json",
      "options": {
        "singleQuote": false,
        "trailingComma": "none"
      }
    },
    // CSS 文件属性值建议使用双引号（URL等）
    {
      "files": "*.css",
      "options": {
        "singleQuote": false
      }
    },
    // Markdown 文档使用较窄的打印宽度，优化阅读流
    {
      "files": "*.md",
      "options": {
        "proseWrap": "always",
        "printWidth": 80
      }
    },
    // HTML 文件属性值应使用双引号
    {
      "files": "*.html",
      "options": {
        "singleQuote": false
      }
    },
    // SVG 文件同样视为 HTML，使用双引号
    {
      "files": "*.svg",
      "options": {
        "singleQuote": false,
        "parser": "html"
      }
    },
    // YAML 文件规范，通常使用双引号或不使用引号，此处禁用单引号偏好
    {
      "files": ["*.yaml", "*.yml"],
      "options": {
        "tabWidth": 2,
        "singleQuote": false
      }
    },
    // JSX/TSX 文件显式声明 bracketSameLine 为 false，确保风格统一
    {
      "files": ["*.tsx", "*.jsx"],
      "options": {
        "bracketSameLine": false
      }
    }
  ]
}
