# =============================================================================
# KHAOS 环境变量模板 (机构级)
# 复制此文件为 .env 并填入实际值。切勿将 .env 提交到版本控制。
# =============================================================================

# ---------- 交易所 API 密钥 (强制) ----------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here

# ---------- 测试网 API 密钥 (可选) ----------
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# ---------- 数据库 ----------
# SQLite 文件路径 (默认 data/khaos.db)
DATABASE_URL=sqlite:///data/khaos.db
# 若使用 PostgreSQL，取消注释并填写：
# DATABASE_URL=postgresql://user:password@localhost:5432/khaos

# ---------- Redis (可选，若不提供则使用内存队列) ----------
REDIS_URL=redis://localhost:6379

# ---------- 日志与数据目录 ----------
KHAOS_LOG_DIR=/var/log/khaos
KHAOS_DATA_DIR=./data

# ---------- 审计签名密钥路径 (若不需要审计可留空) ----------
KHAOS_AUDIT_PRIVATE_KEY=
KHAOS_AUDIT_PUBLIC_KEY=

# ---------- 日志脱敏盐值 ----------
KHAOS_LOG_HASH_SALT=change_me_to_random_string

# ---------- 监控指标密码 (可选) ----------
KHAOS_METRICS_PASSWORD=

# ---------- 代理设置 (可选) ----------
KHAOS_PROXY_USER=
KHAOS_PROXY_PASS=

# ---------- 环境模式 (production / development / staging) ----------
KHAOS_ENV=production
