# ============================================
# KHAOS 量化交易系统 .gitattributes v2.0 (机构级跨平台协作版)
# 经过 50 项缺陷修复，全面保障构建一致性、安全性与团队协作效率。
# ============================================

# ---------- 全局默认：所有文本文件统一 LF ----------
* text=auto eol=lf

# ---------- 脚本语言 (强制 LF) ----------
*.py text eol=lf diff=python
*.pyi text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.php text eol=lf
*.pl text eol=lf
*.pm text eol=lf
*.rb text eol=lf
*.lua text eol=lf
*.r text eol=lf
*.R text eol=lf
*.ps1 text eol=lf          # PowerShell 也支持 LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
Makefile text eol=lf       # Makefile 必须 LF 且 tab 缩进

# ---------- Windows 批处理 (专用 CRLF) ----------
*.bat text eol=crlf
*.cmd text eol=crlf

# ---------- 配置文件 (强制 LF) ----------
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.properties text eol=lf
*.env text eol=lf          # 环境变量文件，方便查看
*.lock text eol=lf merge=union   # 锁文件自动合并减少冲突
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# ---------- 前端与样式 ----------
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.xml text eol=lf
*.svg text eol=lf          # 视为文本以便 code review
*.xsd text eol=lf

# ---------- 文档 ----------
*.md text eol=lf diff=markdown
*.rst text eol=lf
*.txt text eol=lf
*.tex text eol=lf
*.bib text eol=lf

# ---------- 数据交换 ----------
*.csv text eol=lf
*.tsv text eol=lf
*.sql text eol=lf

# ---------- Docker 与容器 ----------
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf

# ---------- 二进制文件 ----------
