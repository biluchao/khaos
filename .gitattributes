# ---------- 导出忽略 (git archive 时不包含) ----------
# 排除开发工具与 CI
.vscode export-ignore
.idea export-ignore
.github export-ignore
.gitlab export-ignore
.git export-ignore
.editorconfig export-ignore
.prettierrc export-ignore
.eslintrc.js export-ignore

# 排除测试与覆盖率
tests export-ignore
__tests__ export-ignore
.pytest_cache export-ignore
.coverage export-ignore
htmlcov export-ignore
coverage.xml export-ignore

# 排除环境文件与密钥
.env export-ignore
.env.* export-ignore
*.pem export-ignore
*.key export-ignore
*.crt export-ignore
secrets export-ignore
credentials export-ignore

# 排除文档与示例
docs export-ignore
*.md export-ignore
LICENSE export-ignore

# 排除本地配置
config/*.local export-ignore
*.development export-ignore
*.staging export-ignore
